{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M03 Certificate Envelope V1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "certificate_id",
    "candidate",
    "policy",
    "evidence",
    "gates",
    "policy_digest",
    "evidence_digest",
    "issuer",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "BLOCKED"
      ]
    },
    "certificate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate": {
      "$ref": "candidate.schema.json"
    },
    "policy": {
      "$ref": "policy.schema.json"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "gates": {
      "$ref": "gates.schema.json"
    },
    "policy_digest": {
      "type": "string"
    },
    "evidence_digest": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
