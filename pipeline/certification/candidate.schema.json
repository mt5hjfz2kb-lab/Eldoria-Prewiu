{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M03 Candidate V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_sha",
    "build_id",
    "build_sha256",
    "artifact_id",
    "executor_id",
    "built_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "build_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "executor_id": {
      "type": "string",
      "minLength": 1
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
