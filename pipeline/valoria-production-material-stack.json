        "normal",
        "roughness_or_smoothness",
        "ao",
        "variation_mask"
      ],
      "optional": [
        "edge_wear_mask",
        "dirt_mask",
        "moss_humidity_mask",
        "trim_sheet"
      ],
      "response": {
        "roughness": "medium-high",
        "metallic": 0
      },
      "usage": [
