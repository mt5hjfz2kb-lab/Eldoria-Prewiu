{
  "schema_version": 1,
  "program": "VALORIA PRODUCTION ART SYSTEM RESET v1",
  "status": "canonical authoring baseline",
  "updated_at": "2026-10-04",
  "texel_density_policy": {
    "principle": "coherent screen-space density by asset role",
    "hero_authoring_max": "2K per major material set initially",
    "primary_authoring_max": "2K when zoom-9 evidence benefits",
    "support_target": "1K when quality survives official cameras",
    "note": "Runtime compression/max size decided in Unity after real camera/device review."
  },
